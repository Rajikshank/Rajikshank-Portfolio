---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
}

const {
  title = `${profile.name} — ${profile.role}`,
  description = profile.description,
  image = "/og/home.png",
  type = "website",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#12100e" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/logo.ico" sizes="any" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("portfolio-theme");
        const systemLight = matchMedia("(prefers-color-scheme: light)").matches;
        document.documentElement.dataset.theme =
          saved === "light" || saved === "dark"
            ? saved
            : systemLight
              ? "light"
              : "dark";
        try {
          if (
            location.pathname === "/" &&
            sessionStorage.getItem("portfolio-intro-played") !== "true"
          ) {
            document.documentElement.dataset.heroIntro = "play";
            sessionStorage.setItem("portfolio-intro-played", "true");
          }
        } catch {
          // The portfolio remains fully visible if storage is unavailable.
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
  </body>
</html>
